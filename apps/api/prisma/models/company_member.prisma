model CompanyMember {
  id String @id @default(uuid()) @db.Uuid

  role   MemberRole
  status MemberStatus @default(ACTIVE)

  companyId       String              @map("company_id") @db.Uuid
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userId          String              @map("user_id") @db.Uuid
  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  sentInvitations CompanyInvitation[] @relation("InvitationInvitedBy")

  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt    DateTime? @map("left_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 복합 FK 대상 (이력·초대의 담당자가 같은 사업자 소속인지 보장)
  @@unique([id, companyId], map: "uk_company_members_id_company")
  // 한 사업자에 같은 사용자는 한 줄만 (재입사 시 기존 행을 ACTIVE로 되돌림)
  @@unique([companyId, userId], map: "uk_company_members_company_user")
  // "내가 속한 사업자 목록" 조회용
  @@index([userId], map: "idx_company_members_user")
  @@map("company_members")
}
