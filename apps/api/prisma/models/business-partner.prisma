// 거래처. 사업자 정보(BusinessProfile)는 내 사업장과 같은 모델을 공유하고,
// 이 모델은 그 사업자를 "누가, 어떤 관계로" 거래하는지를 담는다.
model BusinessPartner {
  id String @id @default(uuid())

  memo String? // 거래처에 대한 내부 메모

  isActive Boolean             @default(true) // false = 거래 종료된 거래처. 기록 보존을 위해 지우지 않고 내린다
  type     BusinessPartnerType @default(CUSTOMER) // 매입처/매출처 구분

  organizationId String // 이 거래처를 관리하는 내 사업장
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict) // 거래처가 남아 있는 한 사업장을 지울 수 없다

  businessProfileId String          @unique // 거래처의 사업자 등록 정보
  BusinessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Restrict) // 거래처가 남아 있는 한 사업자 정보를 지울 수 없다

  businessPartnerContacts BusinessPartnerContact[] // 이 거래처에 속한 담당자

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 소프트 삭제 시각. null이면 유효한 거래처

  @@unique([id, organizationId]) // 담당자가 (id, organizationId)로 참조해 다른 사업장의 거래처를 붙이지 못하게 하는 복합 키
}
