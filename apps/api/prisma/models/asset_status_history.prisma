// 자산 상태 이력. 수정·삭제 없이 쌓기만 함. 정정은 revertsId가 있는 새 행
model AssetStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  // 최초 등록이면 null
  fromStatus    AssetStatus?      @map("from_status")
  toStatus      AssetStatus       @map("to_status")
  reason        String?           @db.VarChar(255)
  sourceType    HistorySourceType @map("source_type")
  // 계약·주문 id 등 (sourceType에 따라 대상 테이블이 달라 FK 없음)
  sourceId      String?           @map("source_id") @db.Uuid
  // 정정(취소)일 때 취소 대상 이력 id
  revertsId     String?           @unique(map: "uk_asset_status_histories_reverts") @map("reverts_id") @db.Uuid
  actorMemberId String            @map("actor_member_id") @db.Uuid
  companyId     String            @map("company_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  assetId     String              @map("asset_id") @db.Uuid
  asset       Asset               @relation(fields: [assetId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict, map: "fk_asset_status_histories_asset")
  reverts     AssetStatusHistory? @relation("HistoryRevert", fields: [revertsId], references: [id], onDelete: Restrict)
  revertedBy  AssetStatusHistory? @relation("HistoryRevert")
  actorMember CompanyMember       @relation(fields: [actorMemberId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict, map: "fk_asset_status_histories_actor")

  @@index([actorMemberId], map: "idx_asset_status_histories_actor")
  @@index([assetId, createdAt], map: "idx_asset_status_histories_asset_created")
  @@map("asset_status_histories")
}
