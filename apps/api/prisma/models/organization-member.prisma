// 사업장 구성원.
// 한 사용자가 여러 사업장에 속할 수 있으므로, 이름·연락처 같은 표시 정보도 사업장별로 따로 관리한다.
model OrganizationMember {
  id String @id @default(uuid())

  name       String // 사업장에서 쓰는 이름
  department String? // 부서
  position   String? // 직급/직책
  phone      String? // 업무용 연락처
  email      String? // 업무용 이메일 (로그인 이메일과 별개)

  role     OrganizationRole @default(STAFF) // 사업장 안에서의 권한 등급
  isActive Boolean          @default(true) // false = 퇴사·비활성 처리되어 사업장 기능을 쓸 수 없다

  userId String // 이 구성원에 해당하는 사용자 계정
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict) // 구성원으로 남아 있는 한 사용자를 지울 수 없다

  organizationId String // 소속 사업장
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict) // 구성원이 남아 있는 한 사업장을 지울 수 없다

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId]) // 다른 테이블이 (id, organizationId)로 참조해 사업장 간 데이터 섞임을 막기 위한 복합 키
  @@unique([userId, organizationId]) // 한 사용자는 같은 사업장에 한 번만 소속된다
}
