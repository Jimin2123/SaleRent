model CompanyInvitation {
  id String @id @default(uuid()) @db.Uuid

  // 소문자로 정규화해서 저장
  inviteeEmail String           @map("invitee_email") @db.VarChar(255)
  // OWNER로는 초대 불가 (raw SQL CHECK). 같은 사업자·이메일의 PENDING 초대는 하나만 (raw SQL 부분 UNIQUE)
  role         MemberRole
  // 초대 링크 토큰의 SHA-256 해시 (원문은 저장하지 않음)
  tokenHash    String           @unique(map: "uk_company_invitations_token") @map("token_hash") @db.Char(64)
  status       InvitationStatus @default(PENDING)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)

  companyId        String        @map("company_id") @db.Uuid
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invitedById      String        @map("invited_by_id") @db.Uuid
  invitedBy        CompanyMember @relation("InvitationInvitedBy", fields: [invitedById, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict, map: "fk_company_invitations_invited_by")
  acceptedByUserId String?       @map("accepted_by_user_id") @db.Uuid
  acceptedByUser   User?         @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  // 사업자별 초대 목록 조회용
  @@index([invitedById], map: "idx_company_invitations_invited_by")
  @@index([acceptedByUserId], map: "idx_company_invitations_accepted_by")
  @@index([companyId, status], map: "idx_company_invitations_company_status")
  @@map("company_invitations")
}
