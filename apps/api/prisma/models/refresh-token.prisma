// 리프레시 토큰 한 건 = 로그인 세션의 한 시점.
// rotation 방식이라 토큰을 재발급할 때마다 새 row가 쌓이고 이전 row는 revoke된다.
model RefreshToken {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade) // 계정을 지우면 세션도 함께 사라진다

  // rotation 체인(같은 로그인 세션)을 묶는 식별자.
  // 로그인 시 새로 발급되고, rotate될 때마다 이전 row의 familyId를 그대로 이어받는다.
  // 이미 revoke된 토큰이 재사용되면 이 familyId 전체를 revoke한다 (reuse detection).
  familyId String @default(cuid())

  tokenHash String    @unique // 원문 미저장, SHA-256 해시만 보관
  expiresAt DateTime // 만료 시각
  revokedAt DateTime? // null = 유효, not null = 무효화됨 (rotate·로그아웃·재사용 탐지)

  userAgent String? // 발급 시점의 기기/브라우저 식별 문자열
  ipAddress String? // 발급 시점의 접속 IP

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([accountId, revokedAt]) // 계정의 유효 세션 목록 조회용
  @@index([familyId, revokedAt]) // 재사용 탐지 시 체인 전체를 한 번에 무효화하기 위한 인덱스
}
