// 소셜 계정 연결 정보.
// 한 계정에 제공자별로 하나씩 연결할 수 있다.
model AccountIdentity {
  id String @id @default(uuid())

  provider   OAuthProvider // 소셜 제공자
  providerId String // 제공자가 발급한 고유 사용자 ID (구글 sub 등)

  providerEmail String? // 제공자가 내려준 이메일. Account.email과 달라도 되며, 이 값이 같다고 기존 계정에 자동 연결하지 않는다
  providerData  Json? // 프로필 사진 URL 등 제공자별 부가 정보

  accountId String // 연결 대상 계정
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade) /// 계정을 지우면 소셜 연결도 함께 사라진다

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, provider]) // 한 계정에 같은 제공자를 두 번 연결할 수 없다
  @@unique([provider, providerId]) // 하나의 소셜 계정은 하나의 계정에만 연결된다
  @@index([accountId])
}
