// 지난 비밀번호 해시 보관.
// 비밀번호 변경 시 최근 이력과 대조해 같은 비밀번호를 다시 쓰지 못하게 한다.
model PasswordHistory {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade) // 계정을 지우면 이력도 함께 사라진다

  passwordHash String // 당시 사용하던 bcrypt 해시 (원문은 저장하지 않는다)
  createdAt    DateTime @default(now()) // 이 비밀번호로 바꾼 시각

  @@index([accountId])
  @@index([accountId, createdAt]) // 계정별 최근 이력 N개 조회용
}
